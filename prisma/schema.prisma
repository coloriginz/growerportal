generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── USERS & AUTH ────────────────────────────────────────

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String?
  name           String
  role           String   @default("grower") // grower, commercie, admin, transporteur, finance
  isActive       Boolean  @default(false)
  activationToken    String?   @unique
  resetToken         String?   @unique
  resetTokenExpiry   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Grower-specific: link to grower profile
  growerId       String?  @unique
  grower         Grower?  @relation(fields: [growerId], references: [id])

  // Commercie: growers assigned to this user
  assignedGrowers Grower[] @relation("CommercieGrowers")

  // Transporteur: link to transporter company
  transporterId  String?
  transporter    Transporter? @relation(fields: [transporterId], references: [id])
}

// ─── GROWER ──────────────────────────────────────────────

model Grower {
  id             String   @id @default(uuid())
  code           String   @unique // e.g. "PCFUP", "COLXSHA"
  name           String
  company        String?
  street         String?
  city           String?
  postalCode     String?
  country        String?
  phone          String?
  vatNumber      String?
  ggn            String?  // GlobalGAP number
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user           User?
  commercie      User?    @relation("CommercieGrowers", fields: [commercieId], references: [id])
  commercieId    String?

  certificates   Certificate[]
  lots           Lot[]
  salesSheets    SalesSheet[]
  documents      Document[]
  qualityIssues  QualityIssue[]
  changeRequests ChangeRequest[]
  forecasts      ShipmentForecast[]

  // Fust
  fustEnabled          Boolean      @default(false)
  autoApproveOrders    Boolean      @default(false)
  defaultTransporterId String?
  defaultTransporter   Transporter? @relation("DefaultTransporter", fields: [defaultTransporterId], references: [id])
  fustOrders           FustOrder[]
  fustCharges          FustGrowerCharge[]

  @@index([commercieId])
}

model Certificate {
  id          String   @id @default(uuid())
  growerId    String
  grower      Grower   @relation(fields: [growerId], references: [id], onDelete: Cascade)
  type        String   // e.g. "GlobalGAP", "MPS"
  number      String
  validFrom   DateTime?
  validUntil  DateTime?
  createdAt   DateTime @default(now())

  @@index([growerId])
}

// ─── SALES SHEETS ────────────────────────────────────────

model SalesSheet {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique
  growerId        String
  grower          Grower   @relation(fields: [growerId], references: [id], onDelete: Cascade)
  invoiceDate     DateTime
  deliveryDate    DateTime
  flightContainer String?
  awbNumber       String?
  totalTurnover   Decimal  @db.Decimal(12, 2)
  totalCosts      Decimal  @db.Decimal(12, 2)
  netResult       Decimal  @db.Decimal(12, 2)
  pdfDocumentId   String?  // Link to Document
  pdfDocument     Document? @relation(fields: [pdfDocumentId], references: [id])
  createdAt       DateTime @default(now())

  lots            Lot[]
  costs           SalesSheetCost[]

  @@index([growerId])
  @@index([invoiceDate])
}

model SalesSheetCost {
  id            String     @id @default(uuid())
  salesSheetId  String
  salesSheet    SalesSheet @relation(fields: [salesSheetId], references: [id], onDelete: Cascade)
  description   String     // e.g. "Commission direct sales", "Handling charges"
  amount        Decimal    @db.Decimal(12, 2)

  @@index([salesSheetId])
}

// ─── LOTS (PARTIJEN) ────────────────────────────────────

model Lot {
  id             String     @id @default(uuid())
  lotNumber      String     // e.g. "3881599"
  refNumber      String     // "Your Ref Number" - links lot to costs
  growerId       String
  grower         Grower     @relation(fields: [growerId], references: [id], onDelete: Cascade)
  salesSheetId   String?
  salesSheet     SalesSheet? @relation(fields: [salesSheetId], references: [id])
  productCode    String     // e.g. "PCFUP"
  productName    String     // e.g. "Protea Cynaroides Madiba"
  articleGroup   String     // e.g. "Protea"
  colli          Int        // Number of boxes/buckets
  stemLength     Int        // cm
  totalStems     Int
  avgPrice       Decimal    @db.Decimal(10, 4)
  totalAmount    Decimal    @db.Decimal(12, 2)
  containerType  String     @default("Box") // Box, Bucket, Other
  deliveryDate   DateTime
  status         String     @default("sold") // in_transit, selling, sold
  createdAt      DateTime   @default(now())

  transactions   Transaction[]
  costs          LotCost[]
  qualityIssues  QualityIssue[]

  @@unique([lotNumber, growerId])
  @@index([growerId])
  @@index([salesSheetId])
  @@index([deliveryDate])
  @@index([refNumber])
}

// ─── TRANSACTIONS ────────────────────────────────────────

model Transaction {
  id            String   @id @default(uuid())
  lotId         String
  lot           Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  date          DateTime
  salesType     String   // "Direct sales", "VBA", "VPL", "Production"
  stems         Int
  pricePerStem  Decimal  @db.Decimal(10, 4)
  amount        Decimal  @db.Decimal(12, 2)
  qualityCode   String?  // e.g. "110"
  qualityNote   String?  // e.g. "Few damaged flowers/bud/fruit"
  s1            String?  // Quality attribute
  s2            String?  // Quality attribute
  s3            String?  // Quality attribute
  isCorrection  Boolean  @default(false) // Handling, stock check, etc.
  correctionType String? // "Handling: less in box", "stock check shortage", etc.
  createdAt     DateTime @default(now())

  @@index([lotId])
  @@index([date])
  @@index([salesType])
}

// ─── LOT COSTS ───────────────────────────────────────────

model LotCost {
  id          String   @id @default(uuid())
  lotId       String
  lot         Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  description String   // e.g. "Handling charges", "Commission direct sales"
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@index([lotId])
}

// ─── DOCUMENTS ───────────────────────────────────────────

model Document {
  id          String   @id @default(uuid())
  growerId    String
  grower      Grower   @relation(fields: [growerId], references: [id], onDelete: Cascade)
  type        String   // "salessheet", "contract", "growing_plan", "other"
  name        String
  fileName    String
  fileUrl     String   // Vercel Blob URL (or local path for dev)
  fileSize    Int?
  mimeType    String?
  uploadedBy  String?  // User ID who uploaded
  createdAt   DateTime @default(now())

  salesSheets SalesSheet[]

  @@index([growerId])
  @@index([type])
}

// ─── QUALITY ISSUES ──────────────────────────────────────

model QualityIssue {
  id          String   @id @default(uuid())
  growerId    String
  grower      Grower   @relation(fields: [growerId], references: [id], onDelete: Cascade)
  lotId       String
  lot         Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  code        String   // e.g. "110", "154"
  description String   // e.g. "Few damaged flowers/bud/fruit"
  stems       Int      // Number of affected stems
  date        DateTime
  createdAt   DateTime @default(now())

  @@index([growerId])
  @@index([lotId])
}

// ─── SHIPMENT FORECASTS ─────────────────────────────

model ShipmentForecast {
  id           String   @id @default(uuid())
  growerId     String
  grower       Grower   @relation(fields: [growerId], references: [id], onDelete: Cascade)
  productName  String
  articleGroup String?
  year         Int
  week         Int
  stems        Int
  trolleys     Int?
  colli        Int?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([growerId, productName, year, week])
  @@index([growerId])
  @@index([year, week])
}

// ─── SETTINGS ───────────────────────────────────────────

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── CHANGE REQUESTS ─────────────────────────────────────

model ChangeRequest {
  id          String   @id @default(uuid())
  growerId    String
  grower      Grower   @relation(fields: [growerId], references: [id], onDelete: Cascade)
  message     String
  status      String   @default("pending") // pending, handled
  createdAt   DateTime @default(now())
  handledAt   DateTime?
  handledBy   String?

  @@index([growerId])
}

// ─── FUST (CONTAINER/CRATE ORDERING) ────────────────────

model Transporter {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  growers   Grower[]   @relation("DefaultTransporter")
  pickups   FustPickup[]
}

model FustType {
  id           String  @id @default(uuid())
  code         String  @unique
  name         String
  category     String  // emmers, karren, kratten, dozen, opzetrekken, overig
  pricePerUnit Decimal @db.Decimal(8,2)
  imageUrl     String?
  isActive     Boolean @default(true)
  sortOrder    Int     @default(0)

  orderItems    FustOrderItem[]
  deliveryItems FustDeliveryItem[]
  invoiceItems  FustInvoiceItem[]
}

model FustOrder {
  id              String    @id @default(uuid())
  orderNumber     String    @unique
  growerId        String
  grower          Grower    @relation(fields: [growerId], references: [id], onDelete: Cascade)
  status          String    @default("pending") // pending, approved, rejected, scheduled, in_transit, delivered, cancelled
  requestedDate   DateTime?
  notes           String?
  rejectionReason String?
  createdById     String?
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items    FustOrderItem[]
  delivery FustDelivery?

  @@index([growerId])
  @@index([status])
  @@index([createdAt])
}

model FustOrderItem {
  id         String    @id @default(uuid())
  orderId    String
  order      FustOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fustTypeId String
  fustType   FustType  @relation(fields: [fustTypeId], references: [id])
  quantity   Int

  @@unique([orderId, fustTypeId])
}

model FustPickup {
  id            String      @id @default(uuid())
  transporterId String
  transporter   Transporter @relation(fields: [transporterId], references: [id])
  pickupDate    DateTime
  status        String      @default("planned") // planned, picked_up, completed
  rfhReference  String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  deliveries FustDelivery[]

  @@index([transporterId])
  @@index([pickupDate])
}

model FustDelivery {
  id          String      @id @default(uuid())
  orderId     String      @unique
  order       FustOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pickupId    String?
  pickup      FustPickup? @relation(fields: [pickupId], references: [id])
  status      String      @default("pending") // pending, in_transit, delivered
  deliveredAt DateTime?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items FustDeliveryItem[]

  @@index([pickupId])
}

model FustDeliveryItem {
  id         String       @id @default(uuid())
  deliveryId String
  delivery   FustDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  fustTypeId String
  fustType   FustType     @relation(fields: [fustTypeId], references: [id])
  quantity   Int

  @@unique([deliveryId, fustTypeId])
}

model FustInvoice {
  id            String    @id @default(uuid())
  invoiceNumber String?
  invoiceDate   DateTime?
  totalAmount   Decimal   @db.Decimal(10,2)
  status        String    @default("pending") // pending, matched, charged, paid
  pdfUrl        String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items   FustInvoiceItem[]
  charges FustGrowerCharge[]

  @@index([status])
}

model FustInvoiceItem {
  id         String      @id @default(uuid())
  invoiceId  String
  invoice    FustInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fustTypeId String
  fustType   FustType    @relation(fields: [fustTypeId], references: [id])
  quantity   Int
  unitPrice  Decimal     @db.Decimal(8,2)
  totalPrice Decimal     @db.Decimal(10,2)
}

model FustGrowerCharge {
  id          String      @id @default(uuid())
  invoiceId   String
  invoice     FustInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  growerId    String
  grower      Grower      @relation(fields: [growerId], references: [id])
  amount      Decimal     @db.Decimal(10,2)
  description String?
  status      String      @default("pending") // pending, invoiced, paid
  createdAt   DateTime    @default(now())

  @@index([growerId])
  @@index([invoiceId])
}
