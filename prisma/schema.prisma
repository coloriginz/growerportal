generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── COMPANIES ─────────────────────────────────────────

model Company {
  id         String   @id @default(uuid())
  name       String   // Display name: "Coloriginz", "MyPeony"
  slug       String   @unique // URL-safe: "coloriginz", "mypeony"
  logoUrl    String?  // Path to logo in public/logos/
  emailFrom  String?  // e.g. "noreply@coloriginz.com"
  emailName  String?  // e.g. "Coloriginz Grower Portal"
  footerText String?  // e.g. "Coloriginz — OZ Import BV, Aalsmeer"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  suppliers   Supplier[]
  users       User[]     @relation("UserCompanies")
  rfhInvoices RfhInvoice[]
}

// ─── USERS & AUTH ────────────────────────────────────────

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String?
  name           String
  role           String   @default("supplier") // supplier, commercie, admin, transporteur, finance
  kbtCode        String?  // KBT identifier for account linking
  // Microsoft Entra object id. Written best-effort on every SSO login. Email is
  // the practical key but not a stable one — people change names and addresses
  // get reissued. Recording the oid now lets us switch the match over later
  // without relinking everyone.
  entraOid       String?  @unique
  isActive       Boolean  @default(false)
  activationToken    String?   @unique
  resetToken         String?   @unique
  resetTokenExpiry   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Supplier-specific: link to supplier profile
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id])

  @@index([supplierId])

  // Label access: which companies/labels this user can see
  companies      Company[] @relation("UserCompanies")

  // Commercie: suppliers assigned to this user
  assignedSuppliers Supplier[] @relation("CommercieSuppliers")

  // Fust grower invoices created by this user
  fustGrowerInvoices FustGrowerInvoice[]

  // RFH invoice allocations
  rfhAllocations RfhVoucherAllocation[] @relation("RfhAllocations")

  // Transporteur: link to transporter company
  transporterId  String?
  transporter    Transporter? @relation(fields: [transporterId], references: [id])
}

// ─── SUPPLIER (formerly Grower — the login entity / leverancier) ──

model Supplier {
  id             String   @id @default(uuid())
  code           String   @unique // e.g. "PCFUP", "COLXSHA"
  name           String
  fabricId       Int?     @unique // rel_id_leverancier from Fabric
  company        String?
  street         String?
  city           String?
  postalCode     String?
  country        String?
  phone          String?
  vatNumber      String?
  ggn            String?  // GlobalGAP number
  preferredLanguage String @default("en") // "en" | "nl"
  accountManagerName String? // AM Naam from Fabric
  accountManagerCode String? // AM Code from Fabric
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  users          User[]
  commercie      User?    @relation("CommercieSuppliers", fields: [commercieId], references: [id])
  commercieId    String?
  seasonStartMonth Int @default(1) // 1=Jan, 10=Oct, etc.

  // Feature toggles (which sections suppliers can see)
  featureSales     Boolean @default(true)  // Verkopen + Leveringen
  featureQuality   Boolean @default(true)  // Kwaliteit
  featureForecasts Boolean @default(true)  // Aanvoerplanning

  // Company branding
  companyId      String?
  companyEntity  Company? @relation(fields: [companyId], references: [id])

  // Sub-entities: kwekers (growers/farms) under this supplier
  growers        Grower[]

  certificates   Certificate[]
  lots           Lot[]
  salesSheets    SalesSheet[]
  documents      Document[]
  qualityIssues  QualityIssue[]
  changeRequests ChangeRequest[]
  forecasts      ShipmentForecast[]

  // Fust
  fustEnabled          Boolean      @default(false)
  autoApproveOrders    Boolean      @default(false)
  defaultTransporterId String?
  defaultTransporter   Transporter? @relation("DefaultTransporter", fields: [defaultTransporterId], references: [id])
  fustOrders           FustOrder[]
  fustCharges          FustGrowerCharge[]
  fustGrowerInvoices   FustGrowerInvoice[]
  rfhAllocations       RfhVoucherAllocation[]

  @@index([commercieId])
  @@index([companyId])
  @@index([defaultTransporterId])
  @@index([fabricId])
}

// ─── GROWER (Kweker — farm sub-entity under Supplier) ──

model Grower {
  id             String   @id @default(uuid())
  fabricId       Int?     @unique // rel_id_kweker from Fabric
  name           String?          // Grower/farm name (if available)
  code           String?          // Grower code from Fabric (e.g. "PCFUP", "V#530453")
  country        String?          // Country name from Fabric (e.g. "Zuid Afrika")
  city           String?          // City from Fabric (e.g. "Waboomskraal")
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lots           Lot[]

  @@index([supplierId])
  @@index([fabricId])
}

model Certificate {
  id          String   @id @default(uuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type        String   // e.g. "GlobalGAP", "MPS"
  number      String
  validFrom   DateTime?
  validUntil  DateTime?
  createdAt   DateTime @default(now())

  @@index([supplierId])
}

// ─── SALES SHEETS ────────────────────────────────────────

model SalesSheet {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique
  fabricParthdrId Int?     @unique // parthdr_id from Fabric (levering-ID)
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  invoiceDate     DateTime
  deliveryDate    DateTime
  flightContainer String?
  awbNumber       String?
  totalTurnover   Decimal  @db.Decimal(12, 2)
  totalCosts      Decimal  @db.Decimal(12, 2)
  netResult       Decimal  @db.Decimal(12, 2)
  lastReceiptDate      DateTime? // Laatste Ontvangstdatum
  lastRegistrationDate DateTime? // Laatste Aanmelddatum
  ourInvoiceNumber    String?  // Our invoice number (e.g. 401546)
  pdfDocumentId   String?  // Link to Document
  pdfDocument     Document? @relation(fields: [pdfDocumentId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  lots            Lot[]
  costs           SalesSheetCost[]

  @@index([supplierId])
  @@index([invoiceDate])
  @@index([fabricParthdrId])
}

model SalesSheetIngestion {
  id              String   @id @default(uuid())
  subject         String?
  fromAddress     String?
  receivedAt      DateTime?
  processedAt     DateTime @default(now())
  status          String   // "PROCESSING" | "PROCESSED" | "PARTIAL" | "ERROR"
  attachmentCount Int      @default(0)
  processedCount  Int      @default(0)
  skippedCount    Int      @default(0)
  details         String?  // JSON: { processed: [...], skipped: [...] }
  errors          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model SalesSheetCost {
  id            String     @id @default(uuid())
  salesSheetId  String
  salesSheet    SalesSheet @relation(fields: [salesSheetId], references: [id], onDelete: Cascade)
  description   String     // e.g. "Commission direct sales", "Handling charges"
  amount        Decimal    @db.Decimal(12, 2)
  fabricShkostId Int?      @unique // shkost_id from Fabric
  fabricKostId   Int?      // kost_id from Fabric
  costTypeCode   String?   // Kost Type Code (VRK, VEI, INK, VWK)
  costTypeName   String?   // Kost Type Naam
  totalTurnover  Decimal?  @db.Decimal(12, 2) // Totaal Omzet (context)
  totalQuantity  Int?      // Totaal Aantal (context)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt

  @@index([salesSheetId])
}

// ─── LOTS (PARTIJEN) ────────────────────────────────────

model Lot {
  id             String     @id @default(uuid())
  lotNumber      String     // Partijnummer
  refNumber      String     // "Your Ref Number" - links lot to costs
  fabricPartId   Int?       @unique // part_id from Fabric
  fabricParthdrId Int?      // parthdr_id from Fabric
  supplierId     String
  supplier       Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  growerId       String?    // Optional link to Grower (kweker sub-entity)
  grower         Grower?    @relation(fields: [growerId], references: [id])
  salesSheetId   String?
  salesSheet     SalesSheet? @relation(fields: [salesSheetId], references: [id])
  articleCode    String?    // Artikel Code from Fabric
  productName    String     // Artikel Naam
  articleGroup   String     // e.g. "Protea"
  purchaseType   String?    // Inkooptype Code (CONS, FOB, CIF)
  fabricArticleId Int?      // art_id from Fabric
  colli          Int        // Number of boxes/buckets
  stemLength     Int        // cm
  totalStems     Int
  avgPrice       Decimal    @db.Decimal(10, 4)
  totalAmount    Decimal    @db.Decimal(12, 2)
  containerType  String     @default("Box") // Box, Bucket, Other
  deliveryDate   DateTime
  status         String     @default("sold") // in_transit, selling, sold
  // Quality attributes (moved from Transaction — exist at lot/partij level)
  s1             String?
  s2             String?
  s3             String?
  // Correction fields
  invoicedColli      Int?   // Inkoopfactuur colli
  invoicedVolume     Int?   // Inkoopfactuur volume
  correctionVolume   Int?   // Aggregate: sum of all LotCorrection.correctionVolume
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt

  transactions   Transaction[]
  qualityIssues  QualityIssue[]
  corrections    LotCorrection[]

  @@unique([lotNumber, supplierId])
  @@index([supplierId])
  @@index([supplierId, productName])
  @@index([supplierId, stemLength])
  @@index([growerId])
  @@index([salesSheetId])
  @@index([deliveryDate])
  @@index([refNumber])
  @@index([fabricPartId])
  @@index([fabricParthdrId])
}

// ─── CORRECTION REASON CODES (REDENCODES) ──────────────────

model CorrectionReasonCode {
  id         Int      @id           // reden_id from Fabric
  code       String                 // "PTWG", "PVTG", etc.
  nameNl     String                 // Dutch name: "Verwerking: te weinig in doos"
  nameEn     String?                // English (future)
  nameEs     String?                // Spanish (future)
  typeCode   String                 // "LEV", "VRD", "VRK", "RET"
  typeNameNl String                 // "Levering correctie reden"
  typeNameEn String?                // English (future)
  active     Boolean  @default(true)
  isClaim    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  corrections LotCorrection[]
}

// ─── LOT CORRECTIONS (PARTIJCORRECTIES) ────────────────────

model LotCorrection {
  id                 String   @id @default(uuid())
  lotId              String
  lot                Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  fabricPartId       Int?     // part_id of the correction row (unique in Fabric)
  facttypeSub        String   // "correctie" or "productiecorrectie"
  correctionReasonId Int?     // reden_id_correctie from Fabric
  correctionReason   CorrectionReasonCode? @relation(fields: [correctionReasonId], references: [id])
  correctionVolume   Int?     // Inslagcorrectie volume (this individual correction)
  correctionColli    Int?     // Inslag colli correctie (this individual correction)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@index([lotId])
  @@index([fabricPartId])
  @@index([correctionReasonId])
}

// ─── TRANSACTIONS ────────────────────────────────────────

model Transaction {
  id            String   @id @default(uuid())
  lotId         String
  lot           Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  fabricOrdregId      Int?    // ordreg_id from Fabric (not unique: same ordreg can span multiple lots)
  fabricGrowerId      Int?    // rel_id_kweker from Fabric (for grower linking)
  date                DateTime
  salesType           String   // "VMP", "Aurora", "Veilen", "Persoonlijk"
  stems               Int
  pricePerStem        Decimal  @db.Decimal(10, 4)
  amount              Decimal  @db.Decimal(12, 3)
  bronFeitExtra       String   @default("origineel") // "origineel", "correcties", "prullenbak-factcor"
  correctionReasonId  Int?     // reden_id from Fabric (no FK — safe with missing codes)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([lotId])
  @@index([date])
  @@index([salesType])
  @@index([fabricOrdregId])
  @@index([bronFeitExtra])
  @@index([correctionReasonId])
}

// ─── IMPORT BATCHES ─────────────────────────────────────

model ImportBatch {
  id               String   @id @default(uuid())
  endpoint         String   // "suppliers", "lots", "orders", "costs"
  status           String   @default("running") // "running", "success", "error"
  recordsReceived  Int      @default(0)
  recordsCreated   Int      @default(0)
  recordsUpdated   Int      @default(0)
  recordsSkipped   Int      @default(0)
  durationMs       Int?
  errorMessage     String?
  details          Json?    // Extra info (e.g. salesSheetsRecalculated, growers created)
  startedAt        DateTime @default(now())
  completedAt      DateTime?

  @@index([endpoint])
  @@index([startedAt])
  @@index([status])
}

// ─── DOCUMENTS ───────────────────────────────────────────

model Document {
  id          String   @id @default(uuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type        String   // "salessheet", "contract", "growing_plan", "other"
  name        String
  fileName    String
  fileUrl     String   // Vercel Blob URL (or local path for dev)
  fileSize    Int?
  mimeType    String?
  uploadedBy  String?  // User ID who uploaded
  createdAt   DateTime @default(now())

  salesSheets SalesSheet[]

  @@index([supplierId])
  @@index([type])
}

// ─── QUALITY ISSUES ──────────────────────────────────────

model QualityIssue {
  id          String   @id @default(uuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  lotId       String
  lot         Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  code        String   // e.g. "110", "154"
  description String   // e.g. "Few damaged flowers/bud/fruit"
  stems       Int      // Number of affected stems
  date        DateTime
  createdAt   DateTime @default(now())

  @@index([supplierId])
  @@index([supplierId, date])
  @@index([lotId])
}

// ─── SHIPMENT FORECASTS ─────────────────────────────

model ShipmentForecast {
  id           String   @id @default(uuid())
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productName  String
  articleGroup String?
  year         Int
  week         Int
  stems        Int
  trolleys     Int?
  colli        Int?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([supplierId, productName, year, week])
  @@index([supplierId])
  @@index([year, week])
}

// ─── SETTINGS ───────────────────────────────────────────

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── CHANGE REQUESTS ─────────────────────────────────────

model ChangeRequest {
  id          String   @id @default(uuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  message     String
  status      String   @default("pending") // pending, handled
  createdAt   DateTime @default(now())
  handledAt   DateTime?
  handledBy   String?

  @@index([supplierId])
}

// ─── FUST (CONTAINER/CRATE ORDERING) ────────────────────

model Transporter {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  preferredLanguage String @default("en") // "en" | "nl"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  suppliers Supplier[] @relation("DefaultTransporter")
  pickups   FustPickup[]
}

model FustType {
  id                  String  @id @default(uuid())
  code                String  @unique
  name                String
  category            String  // emmers, karren, kratten, dozen, opzetrekken, overig
  pricePerUnit        Decimal @db.Decimal(8,2) // statiegeld
  rentalPricePerUnit  Decimal @db.Decimal(8,2) @default(0) // fusthuur
  depositArticleCode  String  @default("2907") // artikelcode statiegeld (Exact Globe)
  rentalArticleCode   String  @default("2908") // artikelcode fusthuur (Exact Globe)
  imageUrl            String?
  isActive            Boolean @default(true)
  sortOrder           Int     @default(0)

  orderItems            FustOrderItem[]
  deliveryItems         FustDeliveryItem[]
  invoiceItems          FustInvoiceItem[]
  issuanceVoucherItems  FustIssuanceVoucherItem[]
  growerInvoiceItems    FustGrowerInvoiceItem[]
}

model FustOrder {
  id              String    @id @default(uuid())
  orderNumber     String    @unique
  supplierId      String
  supplier        Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status          String    @default("pending") // pending, approved, rejected, scheduled, in_transit, delivered, cancelled
  requestedDate   DateTime?
  notes           String?
  rejectionReason String?
  createdById     String?
  approvedById    String?
  approvedAt      DateTime?
  deliveredAt     DateTime?
  deliveredById   String?
  deletedAt       DateTime?
  deletedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items        FustOrderItem[]
  delivery     FustDelivery?
  voucherLinks       FustVoucherOrderLink[]
  growerInvoiceItems FustGrowerInvoiceItem[]
  invoicedAt         DateTime?

  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
}

model FustOrderItem {
  id         String    @id @default(uuid())
  orderId    String
  order      FustOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fustTypeId String
  fustType   FustType  @relation(fields: [fustTypeId], references: [id])
  quantity   Int
  deliveredQuantity Int?

  @@unique([orderId, fustTypeId])
}

model FustPickup {
  id            String      @id @default(uuid())
  transporterId String
  transporter   Transporter @relation(fields: [transporterId], references: [id])
  pickupDate    DateTime
  status        String      @default("planned") // planned, picked_up, completed
  rfhReference  String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  deliveries FustDelivery[]

  @@index([transporterId])
  @@index([pickupDate])
}

model FustDelivery {
  id          String      @id @default(uuid())
  orderId     String      @unique
  order       FustOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pickupId    String?
  pickup      FustPickup? @relation(fields: [pickupId], references: [id])
  status      String      @default("pending") // pending, in_transit, delivered
  deliveredAt DateTime?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items FustDeliveryItem[]

  @@index([pickupId])
}

model FustDeliveryItem {
  id         String       @id @default(uuid())
  deliveryId String
  delivery   FustDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  fustTypeId String
  fustType   FustType     @relation(fields: [fustTypeId], references: [id])
  quantity   Int

  @@unique([deliveryId, fustTypeId])
}

model FustInvoice {
  id            String    @id @default(uuid())
  invoiceNumber String?
  invoiceDate   DateTime?
  totalAmount   Decimal   @db.Decimal(10,2)
  status        String    @default("pending") // pending, matched, charged, paid
  pdfUrl        String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items   FustInvoiceItem[]
  charges FustGrowerCharge[]

  @@index([status])
}

model FustInvoiceItem {
  id         String      @id @default(uuid())
  invoiceId  String
  invoice    FustInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fustTypeId String
  fustType   FustType    @relation(fields: [fustTypeId], references: [id])
  quantity   Int
  unitPrice  Decimal     @db.Decimal(8,2)
  totalPrice Decimal     @db.Decimal(10,2)
}

model FustGrowerCharge {
  id          String      @id @default(uuid())
  invoiceId   String
  invoice     FustInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Supplier    @relation(fields: [supplierId], references: [id])
  amount      Decimal     @db.Decimal(10,2)
  description String?
  status      String      @default("pending") // pending, invoiced, paid
  createdAt   DateTime    @default(now())

  @@index([supplierId])
  @@index([invoiceId])
}

// ─── FUST GROWER INVOICES ──────────────────────────────

model FustGrowerInvoice {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique          // Auto: "FI-2026-0042"
  invoiceDate     DateTime
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id])

  subtotalExVat   Decimal  @db.Decimal(10,2)
  vatRate         Decimal  @db.Decimal(4,2) @default(21.00)
  vatAmount       Decimal  @db.Decimal(10,2)
  totalInclVat    Decimal  @db.Decimal(10,2)

  status          String   @default("draft")  // draft | sent | paid
  pdfUrl          String?                     // Vercel Blob URL
  xmlUrl          String?                     // Vercel Blob URL (eExact XML)
  sentAt          DateTime?
  sentTo          String?                     // email address
  notes           String?

  createdById     String?
  createdBy       User?    @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           FustGrowerInvoiceItem[]

  @@index([supplierId])
  @@index([status])
  @@index([invoiceDate])
}

model FustGrowerInvoiceItem {
  id            String            @id @default(uuid())
  invoiceId     String
  invoice       FustGrowerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderId       String?
  order         FustOrder?        @relation(fields: [orderId], references: [id])
  fustTypeId    String?
  fustType      FustType?         @relation(fields: [fustTypeId], references: [id])

  articleCode   String            // "2907" or "2908" (snapshot)
  description   String            // "Emmers O50cm - Statiegeld" (snapshot)
  quantity      Int
  unitPrice     Decimal           @db.Decimal(8,2)
  totalPrice    Decimal           @db.Decimal(10,2)
  lineType      String            // "deposit" | "rental"

  @@index([invoiceId])
  @@index([orderId])
}

// ─── FUST ISSUANCE VOUCHERS (RFH Uitgiftebonnen) ──────

model FustIssuanceVoucher {
  id                String    @id @default(uuid())
  transactionNumber String    @unique
  type              String    // "uitgifte" | "inname"
  transactionDate   DateTime
  creationDate      DateTime?
  location          String?
  customerNumber    String?
  customerName      String?
  transporterName   String?
  cardNumber        String?
  pdfUrl            String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  items            FustIssuanceVoucherItem[]
  orderLinks       FustVoucherOrderLink[]
  emailIngestions  FustEmailIngestion[]
  rfhAllocations   RfhVoucherAllocation[]

  @@index([transactionNumber])
}

// ─── FUST EMAIL INGESTION LOG ────────────────────────

model FustEmailIngestion {
  id                String               @id @default(uuid())
  subject           String?
  fromAddress       String?
  receivedAt        DateTime?
  processedAt       DateTime             @default(now())
  status            String               @default("PROCESSING") // PROCESSING | PROCESSED | ERROR
  errors            String?              // Error messages (multiple separated by ;)
  emailBody         String?              // Plain text version
  emailBodyHtml     String?              // HTML version (for debugging / display)
  transactionNumber String?              // Extracted from subject
  reportId          String?              // TrackOnline report UUID
  pdfUrl            String?              // Vercel Blob URL of fetched PDF
  voucherId         String?
  voucher           FustIssuanceVoucher? @relation(fields: [voucherId], references: [id])
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status])
  @@index([transactionNumber])
  @@index([createdAt])
}

model FustIssuanceVoucherItem {
  id          String              @id @default(uuid())
  voucherId   String
  voucher     FustIssuanceVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  fustCode    String
  description String
  quantity    Int
  fustTypeId  String?
  fustType    FustType?           @relation(fields: [fustTypeId], references: [id])
}

model FustVoucherOrderLink {
  id        String              @id @default(uuid())
  voucherId String
  voucher   FustIssuanceVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  orderId   String
  order     FustOrder           @relation(fields: [orderId], references: [id])
  createdAt DateTime            @default(now())

  @@unique([voucherId, orderId])
  @@index([voucherId])
  @@index([orderId])
}

// ─── FUST AUDIT LOG ─────────────────────────────────────

model FustAuditLog {
  id          String   @id @default(uuid())
  entityType  String   // order, pickup, delivery, invoice, charge, voucher
  entityId    String
  orderId     String?  // Denormalized FK for fast timeline queries
  action      String   // e.g. order_created, order_approved, pickup_created, etc.
  actorId     String?  // User.id (null for system actions like auto-approve)
  actorName   String?  // Snapshot of user.name to avoid joins
  metadata    Json?    // Action-specific details
  createdAt   DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@index([actorId])
  @@index([createdAt])
}

// ─── RFH INVOICES (Royal FloraHolland fust invoices) ──────

model RfhInvoice {
  id                String   @id @default(uuid())
  invoiceNumber     String   @unique
  rfhInvoiceNumber  String   @unique
  invoiceDate       DateTime
  companyId         String?
  company           Company? @relation(fields: [companyId], references: [id])
  totalStatiegeld   Decimal  @db.Decimal(10, 2)
  totalFusthuur     Decimal  @db.Decimal(10, 2)
  pdfUrl            String?
  status            String   @default("open")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  lines       RfhInvoiceLine[]
  allocations RfhVoucherAllocation[]

  @@index([status])
  @@index([companyId])
  @@index([invoiceDate])
}

model RfhInvoiceLine {
  id               String     @id @default(uuid())
  rfhInvoiceId     String
  rfhInvoice       RfhInvoice @relation(fields: [rfhInvoiceId], references: [id], onDelete: Cascade)
  date             DateTime
  fustCode         String
  description      String
  transactionType  String
  location         String
  voucherNumber    String
  quantity         Int
  statiegeldPrice  Decimal?   @db.Decimal(10, 2)
  statiegeldAmount Decimal?   @db.Decimal(10, 2)
  fusthuurPrice    Decimal?   @db.Decimal(10, 4)
  fusthuurAmount   Decimal?   @db.Decimal(10, 2)
  vatCode          String

  @@index([rfhInvoiceId])
  @@index([voucherNumber])
}

model RfhVoucherAllocation {
  id             String               @id @default(uuid())
  rfhInvoiceId   String
  rfhInvoice     RfhInvoice           @relation(fields: [rfhInvoiceId], references: [id], onDelete: Cascade)
  voucherNumber  String
  voucherId      String?
  voucher        FustIssuanceVoucher?  @relation(fields: [voucherId], references: [id])
  supplierId     String?
  supplier       Supplier?            @relation(fields: [supplierId], references: [id])
  allocatedById  String?
  allocatedBy    User?                @relation("RfhAllocations", fields: [allocatedById], references: [id])
  allocatedAt    DateTime?

  @@unique([rfhInvoiceId, voucherNumber])
  @@index([rfhInvoiceId])
  @@index([voucherId])
  @@index([supplierId])
}

// ─── FABRIC RELATIONS (all Fabric relaties, staging) ──────

model FabricRelation {
  id                 String   @id @default(uuid())
  fabricId           Int      @unique  // rel_id from Fabric
  code               String             // e.g. "COLBFL"
  name               String             // e.g. "Bergflora Capetown"
  accountManagerName String?
  accountManagerCode String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@index([code])
}

// ─── STAGING TABLES (raw Fabric data import) ────────────

model StagingKbtPartij {
  id                    String   @id @default(uuid())
  inkoopFactuurNummer   String?
  partijnummer          Int
  leverDatum            DateTime?
  artikelNaam           String?
  artikelCode           String?
  inkooptypeCode        String?
  s01                   String?
  s02                   String?
  s03                   String?
  partId                Int
  parthdrId             Int
  relIdLeverancier      Int
  artId                 Int?
  redenIdCorrectie      Int?
  inkoopfactuurColli    Int?
  inkoopfactuurVolume   Int?
  inslagcorrectieVolume Int?
  importBatchId         String
  importedAt            DateTime @default(now())

  @@index([partId])
  @@index([parthdrId])
  @@index([relIdLeverancier])
  @@index([importBatchId])
}

model StagingKbtOrder {
  id                 String   @id @default(uuid())
  datumKeyVertrek    DateTime
  partId             Int
  parthdrId          Int
  ordregId           Int
  relIdKweker        Int
  relIdLeverancier   Int
  artikelNaam        String?
  inkooptype         String?
  verkooptype        String?
  verkoopvolume      Int?
  verkoopColli       Int?
  afrekenomzet       Decimal? @db.Decimal(12,2)
  gemAfrekenprijs    Decimal? @db.Decimal(10,4)
  bronFeitExtra      String?
  redenId            Int?
  importBatchId      String
  importedAt         DateTime @default(now())

  @@index([partId])
  @@index([parthdrId])
  @@index([ordregId])
  @@index([relIdLeverancier])
  @@index([importBatchId])
}

model StagingKbtShcost {
  id                     String   @id @default(uuid())
  referentie             String?
  kostNaam               String?
  kostTypeCode           String?
  kostTypeNaam           String?
  totaalOmzet            Decimal? @db.Decimal(12,2)
  totaalAantal           Int?
  salesheetAmount        Decimal? @db.Decimal(12,2)
  laatsteOntvangstdatum  DateTime?
  laatsteAanmelddatum    DateTime?
  parthdrId              Int
  shkostId               Int
  kostId                 Int?
  importBatchId          String
  importedAt             DateTime @default(now())

  @@index([parthdrId])
  @@index([shkostId])
  @@index([importBatchId])
}
